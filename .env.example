# ====================================================================
# MusicWave Production & Development Environment Configuration
# ====================================================================

# Core Application Settings
SECRET_KEY=musicwave_super_secret_production_key_2026
FLASK_ENV=development
DEBUG=True
PORT=5000
DATABASE_PATH=instance/musicwave.db

# --------------------------------------------------------------------
# 1. JAMENDO API (Free Legal Music Streaming & Downloads)
# Get a free client_id at: https://developer.jamendo.com/
# --------------------------------------------------------------------
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=

# --------------------------------------------------------------------
# 2. FREE MUSIC ARCHIVE (FMA) / FREESOUND / INTERNET ARCHIVE
# --------------------------------------------------------------------
INTERNET_ARCHIVE_ENABLED=true
FREE_MUSIC_ARCHIVE_ENABLED=true
FREE_MUSIC_ARCHIVE_API_KEY=

# --------------------------------------------------------------------
# 3. SPOTIFY METADATA & PREVIEWS (Optional)
# Get from: https://developer.spotify.com/dashboard
# --------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --------------------------------------------------------------------
# 4. LAST.FM (Artist Bios, Album Artwork & Recommendations)
# Get from: https://www.last.fm/api/account/create
# --------------------------------------------------------------------
LASTFM_API_KEY=

# --------------------------------------------------------------------
# 5. Media & Storage Limits
# --------------------------------------------------------------------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=33554432 # 32MB
