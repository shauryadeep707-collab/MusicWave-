# MusicWave Environment Configuration
SECRET_KEY=musicwave_super_secret_production_key_change_me_in_prod
FLASK_ENV=development
DEBUG=True
PORT=5000
DATABASE_PATH=instance/musicwave.db

# Music API Configuration (Optional Jamendo Client ID - default fallback included)
JAMENDO_CLIENT_ID=
INTERNET_ARCHIVE_ENABLED=true
FREE_MUSIC_ARCHIVE_ENABLED=true

# Storage Folders
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=33554432 # 32MB
